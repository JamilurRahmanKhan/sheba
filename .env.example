# --- Database (MongoDB Atlas connection string, or mongodb://127.0.0.1:27017 locally) ---
MONGODB_URI=
MONGODB_DB=seba_sohayok

# --- Auth ---
# Random string, at least 32 chars:  openssl rand -base64 48
SESSION_SECRET=

# First-run admin: created automatically on the first login attempt if the users collection is empty.
ADMIN_EMAIL=
ADMIN_NAME=প্রশাসক
ADMIN_PASSWORD=

# --- Vercel Cron (retention job) ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>". openssl rand -hex 24
CRON_SECRET=

# --- Safety: "reset to demo data" is disabled in production unless this is exactly "true" ---
ALLOW_DEMO_RESET=

# --- AI answers (optional; any OpenAI-compatible gateway). Without these the keyword bot is used. ---
LLM_BASE_URL=
LLM_MODEL=
# optional: tried on the 2nd attempt when the main model is busy (429/5xx)
LLM_FALLBACK_MODEL=
LLM_API_KEY=
# max AI calls per day across the whole site (cost cap), default 3000
LLM_DAILY_LIMIT=

# --- Local demo seeding only ---
SEED_OFFICER_PASSWORD=
